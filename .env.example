GUARDIAN_VERSION=0.8.0
GUARDIAN_ENV=production
POSTGRES_USER=guardian
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=guardian_identity
IDENTITY_SIGNING_KEY=replace-with-base64url-encoded-32-byte-ed25519-seed
IDENTITY_JWT_KEY_ID=identity-ed25519-v1
IDENTITY_JWT_ISSUER=urn:it-guardian:identity
IDENTITY_JWT_AUDIENCE=it-guardian-services
IDENTITY_ACCESS_TOKEN_MINUTES=15
IDENTITY_REFRESH_TOKEN_DAYS=7
IDENTITY_PORT=8001
TENANT_DB=guardian_tenant
TENANT_PORT=8002
ASSET_DB=guardian_asset
ASSET_PORT=8003
PKI_DB=guardian_pki
PKI_PORT=8004
PKI_CERTIFICATE_LIFETIME_DAYS=30
ENROLLMENT_DB=guardian_enrollment
ENROLLMENT_PORT=8005
ENROLLMENT_SIGNING_KEY=replace-with-base64url-encoded-32-byte-ed25519-seed
ENROLLMENT_JWT_KEY_ID=enrollment-ed25519-v1
ENROLLMENT_JWT_ISSUER=urn:it-guardian:enrollment
ENROLLMENT_PKI_AUDIENCE=it-guardian-pki
ENROLLMENT_GRANT_LIFETIME_SECONDS=60
AUDIT_DB=guardian_audit
AUDIT_PORT=8006
AUDIT_NATS_DURABLE=guardian-audit-v1
AUDIT_CONSUMER_BATCH_SIZE=100
AGENT_CONTROL_DB=guardian_agent_control
AGENT_CONTROL_PORT=8007
AGENT_CONTROL_OFFLINE_TIMEOUT_SECONDS=180
COMMAND_DB=guardian_command
COMMAND_PORT=8008
TELEMETRY_DB=guardian_telemetry
TELEMETRY_PORT=8009
DEVICE_PROXY_SHARED_SECRET=replace-with-a-long-random-internal-proxy-secret
DEVICE_EDGE_BIND_HOST=0.0.0.0
DEVICE_EDGE_PORT=8443
DEVICE_EDGE_TLS_SERVER_NAMES=localhost,device-edge-service
DEVICE_EDGE_CRL_REFRESH_SECONDS=300
DEVICE_EDGE_MAX_BODY_BYTES=262144
GATEWAY_PORT=8080
GATEWAY_NATS_CONNECT_TIMEOUT_SECONDS=3
GATEWAY_DEFAULT_MAX_BODY_BYTES=1048576
GATEWAY_DEFAULT_TIMEOUT_SECONDS=10
GATEWAY_MAX_REQUEST_ID_LENGTH=128
GATEWAY_MAX_HEADER_BYTES=32768
VALKEY_PASSWORD=replace-with-a-long-url-safe-random-valkey-password
WEB_CONSOLE_PORT=8088
WEB_CONSOLE_SESSION_COOKIE_NAME=itg_session
WEB_CONSOLE_SESSION_TTL_SECONDS=1800
WEB_CONSOLE_MAX_SESSIONS=5000
WEB_CONSOLE_COOKIE_SECURE=true
WEB_CONSOLE_MAX_JSON_BODY_BYTES=262144
NATS_MONITOR_PORT=8222
